# lgpio Debian Package Builder
# Builds: liblgpio1 and liblgpio-dev packages
ARG DEBIAN_DISTRO=bookworm
ARG DEBIAN_ARCH=arm64
FROM --platform=linux/arm64 debian:${DEBIAN_DISTRO}-slim AS arm64-base
FROM ${DEBIAN_ARCH}-base

ARG PACKAGE_VERSION=0.2.2-1
ARG DEBIAN_ARCH
ARG DEBIAN_DISTRO

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    dpkg-dev \
    debhelper \
    fakeroot \
    wget \
    unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Download lgpio source
RUN wget -q http://abyz.me.uk/lg/lg.zip && \
    unzip -q lg.zip

# Build lgpio with Pi5 optimizations
RUN cd lg && \
    # Apply Pi5-specific optimizations for GPIO operations
    # Note: Using -O2 instead of -O3 for predictable timing, no -ffast-math for GPIO reliability
    # Removed -flto due to cross-compilation segfault issues
    export CFLAGS="-mcpu=cortex-a76 -O2 -fomit-frame-pointer -fno-math-errno" && \
    export LDFLAGS="-Wl,--gc-sections" && \
    make -j$(nproc) && \
    make prefix=/build/lg/debian/tmp/usr install

# Create package directory structure for runtime library (liblgpio1)
RUN cd lg && \
    mkdir -p debian/liblgpio1/DEBIAN && \
    mkdir -p debian/liblgpio1/usr/lib/aarch64-linux-gnu

# Create package directory structure for development files (liblgpio-dev)
RUN cd lg && \
    mkdir -p debian/liblgpio-dev/DEBIAN && \
    mkdir -p debian/liblgpio-dev/usr/include && \
    mkdir -p debian/liblgpio-dev/usr/lib/aarch64-linux-gnu/pkgconfig

# Install runtime libraries to liblgpio1 package
RUN cd lg && \
    mv debian/tmp/usr/lib/*.so.* debian/liblgpio1/usr/lib/aarch64-linux-gnu/ || true

# Install development files to liblgpio-dev package
RUN cd lg && \
    cp -a debian/tmp/usr/include/* debian/liblgpio-dev/usr/include/ && \
    mv debian/tmp/usr/lib/*.so debian/liblgpio-dev/usr/lib/aarch64-linux-gnu/ || true && \
    mv debian/tmp/usr/lib/*.a debian/liblgpio-dev/usr/lib/aarch64-linux-gnu/ || true && \
    # Create pkg-config file
    printf '%s\n' \
        'prefix=/usr' \
        'exec_prefix=${prefix}' \
        'libdir=${exec_prefix}/lib/aarch64-linux-gnu' \
        'includedir=${prefix}/include' \
        '' \
        'Name: lgpio' \
        'Description: GPIO library for Linux' \
        'Version: 0.2.2' \
        'Libs: -L${libdir} -llgpio' \
        'Cflags: -I${includedir}' \
        > debian/liblgpio-dev/usr/lib/aarch64-linux-gnu/pkgconfig/lgpio.pc

# Create control file for runtime library
RUN cd lg/debian/liblgpio1/DEBIAN && \
    printf '%s\n' \
        "Package: liblgpio1" \
        "Version: ${PACKAGE_VERSION}" \
        "Architecture: ${DEBIAN_ARCH}" \
        "Maintainer: PiTrac Build System <build@pitrac.org>" \
        "Section: libs" \
        "Priority: optional" \
        "Homepage: http://abyz.me.uk/lg/" \
        "Description: GPIO library for Linux - runtime" \
        " A library for handling GPIO operations on Linux systems." \
        " This package contains the runtime library." \
        "Replaces: liblgpio1 (<= 0.2.2-1~rpt99)" \
        "Conflicts: liblgpio1 (<= 0.2.2-1~rpt99)" \
        "Provides: liblgpio1" \
        > control

# Create control file for development package
RUN cd lg/debian/liblgpio-dev/DEBIAN && \
    printf '%s\n' \
        "Package: liblgpio-dev" \
        "Version: ${PACKAGE_VERSION}" \
        "Architecture: ${DEBIAN_ARCH}" \
        "Maintainer: PiTrac Build System <build@pitrac.org>" \
        "Section: libdevel" \
        "Priority: optional" \
        "Depends: liblgpio1 (= ${PACKAGE_VERSION})" \
        "Homepage: http://abyz.me.uk/lg/" \
        "Description: GPIO library for Linux - development files" \
        " A library for handling GPIO operations on Linux systems." \
        " This package contains the development files (headers and static libraries)." \
        "Replaces: liblgpio-dev (<= 0.2.2-1~rpt99)" \
        "Conflicts: liblgpio-dev (<= 0.2.2-1~rpt99)" \
        "Provides: liblgpio-dev" \
        > control

# Build both packages
RUN cd lg && \
    dpkg-deb --build --root-owner-group debian/liblgpio1 liblgpio1_${PACKAGE_VERSION}_${DEBIAN_ARCH}.deb && \
    dpkg-deb --build --root-owner-group debian/liblgpio-dev liblgpio-dev_${PACKAGE_VERSION}_${DEBIAN_ARCH}.deb

# Move to output location
RUN mkdir -p /output && \
    mv lg/*.deb /output/ && \
    ls -la /output/

# Keep container running for extraction
CMD ["sleep", "infinity"]